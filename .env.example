# Set TWO providers: the first available (Groq > Gemini > Anthropic) generates
# answers and the next one grades them. With only one key, the model grades its
# own answers (self-grading bias) and the suites print a warning.
# Groq and Gemini both have genuinely free tiers, no card required.

# Free — https://console.groq.com
GROQ_API_KEY=your_key_here

# Free — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Paid — https://console.anthropic.com/settings/billing
# ANTHROPIC_API_KEY=your_key_here

# Optional: force roles instead of auto-detecting (groq | gemini | anthropic)
# LLM_PROVIDER=groq
# JUDGE_PROVIDER=gemini
# JUDGE_MODEL=gemini-3.5-flash-lite   # a different judge model, even on the same provider

# Optional: override default models
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_MODEL=claude-sonnet-5
