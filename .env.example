# Set only ONE of these (the pipeline auto-detects which to use).
# Groq and Gemini both have genuinely free tiers, no card required.

# Free — https://console.groq.com
GROQ_API_KEY=your_key_here

# Free — https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_key_here

# Paid — https://console.anthropic.com/settings/billing
# ANTHROPIC_API_KEY=your_key_here

# Optional: force a provider instead of auto-detecting (groq | gemini | anthropic)
# LLM_PROVIDER=groq
